# Copy to .env (repo root). The backend reads this file; secrets never reach the browser.

# --- LLM: OpenRouter ---------------------------------------------------------
OPENROUTER_API_KEY=
# Default model for every stage. Any OpenRouter model id with JSON output support.
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# Optional per-stage overrides (fall back to OPENROUTER_MODEL)
LLM_MODEL_EXTRACTION=anthropic/claude-sonnet-5.5
LLM_MODEL_CONVERSATION=anthropic/claude-sonnet-5.5
LLM_MODEL_SIMULATOR=anthropic/claude-haiku-5.5
# The agent's live lines and running notes: speed matters most (reasoning is switched off).
LLM_MODEL_LIVE=anthropic/claude-haiku-5.5
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=1800
LLM_TIMEOUT_S=60
LLM_TIMEOUT_LIVE_S=20

# --- Speech: Sarvam AI (Saaras STT, Bulbul TTS) -------------------------------
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_STT_REST_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_AGENT_SPEAKER=priya
SARVAM_TTS_COUNTERPARTY_SPEAKER=rahul
SARVAM_TTS_SAMPLE_RATE=22050

# --- Persistence: Supabase -----------------------------------------------------
# `supabase start` prints these. Leave empty to use in-memory storage.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Sign-in (Google via Supabase Auth) is on whenever SUPABASE_URL is set.
# AUTH_DISABLED=false
# SUPABASE_JWT_SECRET=          # only for legacy HS256-signed projects
# MAX_MISSIONS_PER_DAY=30
# MAX_CONVERSATIONS_PER_DAY=20

# Billing (Razorpay). Off when the keys are unset. Create the plan with scripts/create_plan.py.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
FREE_ACCOUNTS=                        # comma-separated sign-in emails that never pay
# PLAN_PRICE_INR=499
# MONTHLY_TALK_MINUTES=180      # never shown in the UI
# TRIAL_TALK_MINUTES=3          # the free mission's hidden cap, across its calls

# --- App -------------------------------------------------------------------------
# Force the labelled demo LLM even when a key is present.
DEMO_MODE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (frontend/.env.local) -----------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
# Browser sign-in: the project URL and its publishable (anon) key. Put these in frontend/.env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# English renderings of non-English lines in the transcript
SARVAM_TRANSLATE_MODEL=mayura:v1
# Practice mode: work out the next lines while the current one is spoken
SPECULATE=true

# Phone calls through Exotel (off when unset). Kept server-side; never sent to the browser.
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com       # api.in.exotel.com for Mumbai-region accounts
EXOTEL_CALLER_ID=                     # your ExoPhone
TELEPHONY_SECRET=                     # any long random string: signs Exotel's stream/callback URLs
PUBLIC_BASE_URL=https://www.sakhi.buzz  # where Exotel reaches this backend
PHONE_CALL_LIMIT_SECONDS=240
